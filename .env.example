# Copy to .env and fill in.

# Local development: run `npm run db:dev` (Prisma Postgres) and use the URL it prints,
# with `pgbouncer=true` appended. Example:
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=5&connect_timeout=0&max_idle_connection_lifetime=5&pool_timeout=0&socket_timeout=0"

# Production: use your Neon / Supabase connection string instead, e.g.
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/censeo?sslmode=require"

# 32+ character random secret used to sign session JWTs. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""
