// Censeo (CountBook v2) — Inventory & Sales Management
// Stock on hand is NEVER stored as a mutable counter: it is derived from the
// append-only StockMovement ledger so every unit in/out is auditable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
}

enum TxStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum MovementType {
  RECEIPT
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sales     Sale[]
  receipts  StockReceipt[]
  movements StockMovement[]
  transfers StockTransfer[]
}

model Product {
  id              String  @id @default(cuid())
  sku             String  @unique
  name            String
  description     String?
  category        String  @default("General")
  unitPrice       Decimal @db.Decimal(12, 2)
  costPrice       Decimal @db.Decimal(12, 2) @default(0)
  reorderLevel    Int     @default(10)
  isActive        Boolean @default(true)
  isSerialTracked Boolean @default(false)
  requiresExpiry  Boolean @default(false)
  isService       Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  saleItems SaleItem[]
  receipts  StockReceipt[]
  movements StockMovement[]
  transfers StockTransfer[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  sales Sale[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  receipts StockReceipt[]
}

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  location String?

  receipts      StockReceipt[]
  sales         Sale[]
  movements     StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
}

/// Goods received from a supplier ("Add Stock" in the legacy app).
model StockReceipt {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  supplierId  String?
  quantity    Int
  unitCost    Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  status      TxStatus @default(COMPLETED)
  createdById String?
  createdAt   DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  supplier  Supplier?  @relation(fields: [supplierId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id])
}

model Sale {
  id            String        @id @default(cuid())
  reference     String        @unique
  customerId    String?
  customerName  String? // manual / walk-in customer entry
  warehouseId   String
  date          DateTime      @default(now())
  paymentMethod PaymentMethod
  status        TxStatus      @default(COMPLETED)
  total         Decimal       @db.Decimal(14, 2)
  createdById   String?
  createdAt     DateTime      @default(now())

  customer  Customer?  @relation(fields: [customerId], references: [id])
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id])
  items     SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StockTransfer {
  id              String         @id @default(cuid())
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  quantity        Int
  status          TransferStatus @default(PENDING)
  requestedById   String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  product       Product   @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  requestedBy   User?     @relation(fields: [requestedById], references: [id])
}

/// Append-only ledger. quantity is signed: positive = stock in, negative = stock out.
model StockMovement {
  id          String       @id @default(cuid())
  productId   String
  warehouseId String
  type        MovementType
  quantity    Int
  reference   String? // e.g. sale reference or receipt id
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([productId, warehouseId])
  @@index([createdAt])
}
